    "@tanstack/react-query": "^5.49.2",
    "@trpc/client": "11.0.0-rc.441",
    "@trpc/react-query": "11.0.0-rc.441",
    "@trpc/server": "11.0.0-rc.441",
    "@types/eslint": "^9.6.1",
    "@types/figlet": "^1.5.8",
    "@types/fs-extra": "^11.0.4",
    "@types/gradient-string": "^1.1.6",
    "@types/node": "^20.16.11",
    "@types/react": "^19.2.17",
    "clsx": "^2.1.1",
