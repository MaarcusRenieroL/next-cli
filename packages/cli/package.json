    "eslint": "^9.39.1",
    "hono": "^4.6.4",
    "mysql2": "^3.11.0",
    "next": "^16.2.10",
    "postgres": "^3.4.4",
    "prettier": "^3.3.2",
    "prettier-plugin-tailwindcss": "^0.6.5",
