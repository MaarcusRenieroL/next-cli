{
  "name": "@mxrcxs17/next-kit",
  "version": "1.0.2",
  "publishConfig": {
    "access": "public"
  },
  "description": "Nextkit — an interactive CLI built with Node.js and TypeScript to scaffold full-stack Next.js projects in seconds",
  "homepage": "https://github.com/MaarcusRenieroL/next-cli#readme",
  "license": "ISC",
  "author": "",
  "type": "module",
  "exports": "./dist/index.js",
  "bin": {
    "next-kit": "dist/index.js"
  },
  "engines": {
    "node": ">=18.17.0"
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist && rimraf components",
    "start": "node dist/index.js"
  },
  "files": [
    "dist",
    "template",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    ".yarnrc.yml",
    "package.json"
  ],
  "dependencies": {
