    "boxen": "^8.0.1",
    "cfonts": "^3.3.0",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "figlet": "^1.7.0",
    "fs-extra": "^11.2.0",
    "ora": "^8.1.0",
    "sort-package-json": "^2.10.1"
  },
  "devDependencies": {
    "@auth/drizzle-adapter": "^1.1.0",
    "@auth/prisma-adapter": "^1.6.0",
    "@libsql/client": "^0.12.0",
    "@planetscale/database": "^1.19.0",
    "@prisma/adapter-planetscale": "^5.14.0",
    "@prisma/client": "^5.14.0",
